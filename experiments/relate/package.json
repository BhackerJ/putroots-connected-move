{
  "name": "connected-move",
  "version": "0.1.0",
  "description": "Put Roots Connected Move: checks a moving plan against its documents with a Relate graph.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test move-graph.test.mjs",
    "seed": "node make-seed.mjs",
    "prestart": "esbuild local-mail.mjs --bundle --format=esm --outfile=node_modules/.cache/connected-move/local-mail.js",
    "build:judge": "node judge/build.mjs"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@relate/relate": "1.0.1",
    "@relate/relate-wasm": "1.0.1",
    "esbuild": "0.28.2",
    "firebase": "13.4.0"
  }
}
